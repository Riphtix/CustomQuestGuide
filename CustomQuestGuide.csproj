<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.4.0.0</Version>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <FileVersion>1.4.0.0</FileVersion>
    <Description>Custom Quest Guide helps you work toward the items, unlocks, and achievements you want in FFXIV. Search for gear, mounts, minions, titles, duties, jobs, relics, and curated sets; see acquisition methods and prerequisites; and pin your goals for quick access. Follow quest and NPC guidance, use map pins and duty shortcuts where available, and see which targets you already own or have unlocked.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data/Verified/job-progression.json"
                      LogicalName="CustomQuestGuide.Data.Verified.job-progression.json" />
  </ItemGroup>

  <!--
    LuminaSupplemental contains community-maintained data that the game itself
    does not ship, including duty drops, Mog Station / Square Enix Store items,
    and unobtainable items.

    We intentionally load its CSV resources through reflection at runtime so the
    core plugin is not tightly coupled to the package's model namespaces.
  -->
  <ItemGroup>
    <PackageReference Include="LuminaSupplemental.Excel" Version="5.1.5" />
  </ItemGroup>
</Project>
